# Copia este archivo a .env.local y completa los valores.

# --- Base de datos -----------------------------------------------------------
DATABASE_URL=postgres://claro:claro@localhost:55433/claro_one

# --- Autenticación (Better Auth + Google Workspace) -------------------------
# Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# OAuth client "Web application" en Google Cloud Console.
# Redirect URI autorizado: http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solo entran correos de este dominio (Fase 1: solo personal interno).
ALLOWED_EMAIL_DOMAIN=claroinsurance.com

# --- Arranque ------------------------------------------------------------------
# El primer Configurador/Admin. `pnpm db:bootstrap` lo crea con alcance global.
BOOTSTRAP_ADMIN_EMAIL=product@claroinsurance.com
BOOTSTRAP_ADMIN_NOMBRE=Product Claro One

# --- Solo desarrollo -----------------------------------------------------------
# Sin credenciales de Google todavía: entra como este correo sin login.
# Se ignora por completo cuando NODE_ENV=production.
DEV_LOGIN_EMAIL=product@claroinsurance.com
